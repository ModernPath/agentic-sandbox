# Client sandbox instance. Copy to instances/<client>.env (git-ignored) and fill in keys.
# Both providers stay available in this codebase; this instance uses OpenAI for now.
# To use Gemini instead, change the provider lines and set GEMINI_API_KEY.

# Models (sandbox blocks: agents, tools, search, page reader)
SANDBOX_LLM_PROVIDER=openai
SANDBOX_LLM_MODEL=gpt-6-luna
SANDBOX_SEARCH_PROVIDER=openai
SANDBOX_SEARCH_MODEL=gpt-6-luna
SANDBOX_READER_PROVIDER=local

# Embeddings (sandbox blocks)
SANDBOX_EMBEDDING_PROVIDER=openai
SANDBOX_EMBEDDING_MODEL=text-embedding-3-small
SANDBOX_EMBEDDING_DIMENSIONS=768

# Signal-intelligence knowledge index (its own setting; same choice as above)
KNOWLEDGE_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Keys (never commit)
OPENAI_API_KEY=
# GEMINI_API_KEY=   (not needed for this instance)
# EXA_API_KEY=      (optional, people and company search)

# Host
DATABASE_URL=
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8100
