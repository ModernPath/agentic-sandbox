# Copy to .env and fill in only the providers you have permission to use.
# Never commit .env or real keys.

# --- Agent building blocks (src/sandbox_blocks) ---
# LLM: gemini | openai
SANDBOX_LLM_PROVIDER=gemini
# SANDBOX_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Web search: none | gemini | openai | exa   (none = search disabled)
SANDBOX_SEARCH_PROVIDER=none
# SANDBOX_SEARCH_MODEL=
# EXA_API_KEY=
# Exa Agent runs (people and company lists): effort auto|minimal|low|medium|high|xhigh|ultra, cost ceiling 1-100 USD
SANDBOX_EXA_AGENT_EFFORT=auto
SANDBOX_EXA_AGENT_MAX_COST_DOLLARS=2
SANDBOX_SEARCH_MAX_RESULTS=5
SANDBOX_FETCH_MAX_CHARS=8000
SANDBOX_HTTP_TIMEOUT_SECONDS=30

# --- Shared application database and web host (SignalScout code) ---
POSTGRES_PASSWORD=
WEB_PORT=8000
# Host PostgreSQL URL for direct Python runs; Compose ignores it.
# DATABASE_URL=postgresql+psycopg://signalscout:URL_ENCODED_PASSWORD@127.0.0.1:5432/signalscout

# --- Sandbox host (sandbox_app.py) ---
# Bind address. Keep 127.0.0.1 until an auth layer is configured.
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8100
# Shared sandbox database. Any PostgreSQL URL works, including Supabase (postgresql+psycopg://).
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/DB

# Anthropic (used when SANDBOX_LLM_PROVIDER=anthropic; client instances prefer this over Gemini)
# ANTHROPIC_API_KEY=

# Azure OpenAI on Azure AI Foundry (SANDBOX_LLM_PROVIDER=azure or SANDBOX_SEARCH_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://RESOURCE.services.ai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-6-luna

# Page reader used by agents: local | exa | gemini (exa: Exa /contents; gemini: Gemini url_context)
# SANDBOX_READER_PROVIDER=local
# SANDBOX_READER_MODEL=

# Embeddings for retrieval (sandbox blocks): none | openai | azure. Default none.
# SANDBOX_EMBEDDING_PROVIDER=none
# SANDBOX_EMBEDDING_MODEL=text-embedding-3-small   (azure: your embedding deployment name)
# SANDBOX_EMBEDDING_DIMENSIONS=768
