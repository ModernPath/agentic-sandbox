# Sandbox host: one web process for every registered agent. Configure with environment variables only.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/agents
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY templates ./templates
COPY agents ./agents
COPY sandbox_app.py ./
RUN pip install --no-cache-dir . \
 && useradd --create-home --uid 10001 sandbox \
 && chown -R sandbox:sandbox /app

USER sandbox
EXPOSE 8100
HEALTHCHECK --interval=10s --timeout=4s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8100/api/health', timeout=3)"
CMD ["uvicorn", "sandbox_app:create_sandbox_app", "--factory", "--host", "0.0.0.0", "--port", "8100"]
